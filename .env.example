# Application
APP_NAME=Prism Workbench
APP_VERSION=1.0.0
DEBUG=false
DEMO_MODE=false

# Server
HOST=127.0.0.1
PORT=8000

# Database
# SQLite (development): DATABASE_URL=sqlite+aiosqlite:///./prism.db
# PostgreSQL (production): DATABASE_URL=postgresql+asyncpg://user:password@host:5432/prism
DATABASE_URL=sqlite+aiosqlite:///./prism.db
DATABASE_ECHO=false

# Security
# Generate with: openssl rand -base64 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OIDC / Keycloak
OIDC_ENABLED=true
OIDC_ISSUER_URL=http://localhost:8080/realms/prism
OIDC_CLIENT_ID=prism-workbench
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_SCOPES=openid,profile,email,roles

# Session
SESSION_COOKIE_NAME=prism_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_PATH=/

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true

# GitHub
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_CLONE_TIMEOUT=120
GITHUB_SPARSE_CHECKOUT=true

# Skill Installation
SKILL_INSTALL_DIRS=[".claude/skills",".cursor/skills",".agents/skills",".codex/skills"]
GLOBAL_SKILL_DIR=~/.agents/skills
LOCKFILE_NAME=skills-lock.json
GLOBAL_LOCKFILE_PATH=~/.agents/.skill-lock.json

# LLM (Optional, for AI/ML evaluation)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=2

# Redis (Optional, for production session storage)
REDIS_URL=
REDIS_ENABLED=false

# Keycloak (for docker-compose)
POSTGRES_PASSWORD=prism_dev_password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
OIDC_CLIENT_SECRET=prism-workbench-secret-change-in-production